<% layout("../layouts/application", { header: it.t('views.statuses.header') }) %>

<div>
   <form action="<%= it.route('statuses') %>" method="post">
        <%~ include("../mixins/input", { entity: it.status, propertyName: it.t('views.status.new.title'), errors: it.errors, type: 'text' }) %>
        <%~ include("../mixins/submit", { value: it.t('views.status.new.submit') }) %>
   </form>
</div>